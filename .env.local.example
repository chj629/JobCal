# Supabase Connect 화면에서 값을 복사해 .env.local 파일을 새로 만들고 채워 넣으세요.
# 이 파일 자체(.env.local.example)에는 실제 값을 적지 마세요.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용 (클라이언트에 노출되지 않음). AI 메일 분석 Route Handler에서만 사용.
OPENAI_API_KEY=
# 생략 시 app/api/ai/analyze-email/route.ts의 기본값 사용.
OPENAI_MODEL=

# 서버 전용 (클라이언트에 절대 노출되지 않음). Supabase Dashboard의 Project Settings ->
# API -> service_role 키. app/api/account/delete/route.ts(계정 삭제)에서만 사용.
SUPABASE_SERVICE_ROLE_KEY=

# 서버 전용 (클라이언트에 노출되지 않음). Resend Dashboard -> API Keys에서 발급.
# app/api/contact/route.ts(문의 메일 발송)에서만 사용.
RESEND_API_KEY=
# 문의 메일을 받을 운영자 이메일 주소. 비어 있으면 /api/contact가 500을 반환한다.
CONTACT_EMAIL=

# sandbox 또는 production. 값이 없거나 "production"이 아니면 sandbox로 취급한다.
# app/api/paddle/webhook(Paddle Node SDK)과 app/(app)/settings/page.tsx(Paddle.js
# Checkout) 둘 다에서 사용.
NEXT_PUBLIC_PADDLE_ENV=

# 서버 전용 (클라이언트에 노출되지 않음). Paddle Dashboard -> Developer tools ->
# Authentication에서 발급. app/api/paddle/webhook에서만 사용.
PADDLE_API_KEY=

# 서버 전용 (클라이언트에 노출되지 않음). Paddle Dashboard -> Developer tools ->
# Notifications에서 이 webhook(app/api/paddle/webhook) 목적지를 만들 때 발급되는 값.
# sandbox와 production은 서로 다른 notification destination이므로 secret도 다르다.
PADDLE_NOTIFICATION_WEBHOOK_SECRET=

# 클라이언트에 노출되는 값(비밀 아님). Paddle Dashboard -> Developer tools ->
# Authentication에서 발급하는 client-side token. app/(app)/settings/page.tsx의
# Paddle.js Checkout 초기화에서만 사용.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# 클라이언트에 노출되는 값(비밀 아님, price ID는 공개 식별자). JobCal Pro 월 구독 price의
# Paddle price ID(pri_...). app/(app)/settings/page.tsx의 "Pro로 업그레이드" 버튼에서 사용.
NEXT_PUBLIC_PADDLE_PRO_PRICE_ID=
